# stock-platform/backend（FastAPI）のベースURL。
# 同じバックエンドを共有して市況サマリー・スクリーニング比較表を表示します。
# 未起動・未接続の場合は data/*-seed.json のフォールバック値が表示されます。
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# サイトの本番URL（独自ドメイン取得後に設定。sitemap.xml / robots.txt / AdSense申請で使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSenseのPublisher ID（未設定の場合は広告枠にプレースホルダーが表示されます）
# 審査に申請し承認されて取得した ca-pub-xxxxxxxxxxxxxxxx をここに設定してください。
NEXT_PUBLIC_ADSENSE_ID=ca-pub-xxxxxxxxxxxxxxxx
